# Server only. Set real values in the hosting provider; never commit credentials.
DATABASE_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
ADMIN_EMAILS=
# 32-byte independent AES keys, each encoded as 64 hex characters.
INVENTORY_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
# Official Slip2Go REST endpoint ending /api/verify-slip/qr-image/info.
SLIP2GO_VERIFY_URL=
SLIP2GO_API_SECRET=
PROMPTPAY_RECEIVER=
# Direct Google OAuth; register /api/auth/callback/google on this site's origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
# Optional transactional password-reset and verification mail.
RESEND_API_KEY=
EMAIL_FROM=
# External scheduler sends POST /api/jobs/run with Bearer CRON_SECRET.
CRON_SECRET=
BACKUP_EVERY_HOURS=24
# Optional existing broker OAuth.
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
